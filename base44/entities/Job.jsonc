{
  "name": "Job",
  "type": "object",
  "properties": {
    "company": {
      "type": "string",
      "title": "Company"
    },
    "role": {
      "type": "string",
      "title": "Role"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "job_description": {
      "type": "string",
      "title": "Job description"
    },
    "link": {
      "type": "string",
      "title": "Link"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Recommended",
        "Saved",
        "Applied",
        "Interviewing",
        "Offer",
        "Rejected"
      ],
      "enumColors": [
        "purple",
        "gray",
        "blue",
        "yellow",
        "green",
        "red"
      ],
      "default": "Recommended"
    },
    "fit_score": {
      "type": "number",
      "title": "Overall fit score (0-100)"
    },
    "fit_reason": {
      "type": "string",
      "title": "Why it's a fit (one line)"
    },
    "pick_date": {
      "type": "string",
      "format": "date",
      "title": "Picked on"
    },
    "skill_scores": {
      "type": "array",
      "title": "Skill scores (1-5)",
      "items": {
        "type": "object",
        "properties": {
          "skill": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "skill_gaps": {
      "type": "array",
      "title": "Skill gaps",
      "items": {
        "type": "string"
      }
    },
    "tailored_resume_bullets": {
      "type": "array",
      "title": "Tailored resume bullets",
      "items": {
        "type": "string"
      }
    },
    "date_added": {
      "type": "string",
      "format": "date",
      "title": "Date applied"
    },
    "date_posted": {
      "type": "string",
      "format": "date",
      "title": "Date posting went live"
    },
    "salary": {
      "type": "string",
      "title": "Salary"
    },
    "employment_type": {
      "type": "string",
      "title": "Employment type",
      "enum": [
        "Full-Time",
        "Part-Time"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "source": {
      "type": "string",
      "title": "Source",
      "enum": [
        "LinkedIn",
        "Referral",
        "Company",
        "Gmail",
        "Recruiter"
      ],
      "enumColors": [
        "blue",
        "red",
        "purple",
        "yellow",
        "gray"
      ]
    },
    "applied_via": {
      "type": "string",
      "title": "Applied via",
      "enum": [
        "LinkedIn",
        "Referral",
        "Company",
        "Gmail",
        "Recruiter"
      ],
      "enumColors": [
        "blue",
        "red",
        "purple",
        "yellow",
        "gray"
      ]
    },
    "contact_name": {
      "type": "string",
      "title": "Contact name"
    },
    "reply_received": {
      "type": "boolean",
      "title": "Reply received",
      "default": false
    },
    "linkedin_dm": {
      "type": "boolean",
      "title": "LinkedIn DM sent",
      "default": false
    },
    "sent_email": {
      "type": "boolean",
      "title": "Email sent",
      "default": false
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "company",
    "role"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}