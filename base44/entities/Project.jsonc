{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Project name"
    },
    "link": {
      "type": "string",
      "title": "Link"
    },
    "description": {
      "type": "string",
      "title": "Two-sentence description"
    },
    "role": {
      "type": "string",
      "title": "My role"
    },
    "tags": {
      "type": "array",
      "title": "Tags",
      "items": {
        "type": "string"
      }
    },
    "preview_image_uri": {
      "type": "string",
      "title": "Preview image (private file)"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}