{
  "name": "JobSource",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Company or source name"
    },
    "careers_url": {
      "type": "string",
      "title": "Careers page URL"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "enabled": {
      "type": "boolean",
      "title": "Include in daily search",
      "default": true
    }
  },
  "required": [
    "name",
    "careers_url"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}